# Copy to .env and fill in. Never commit .env - it's gitignored.

# PostgreSQL - matches drizzle.config.json. For Docker: see README.
#   docker run --name pg-pixel-village -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=app_db -p 5432:5432 -d postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Phase 3 - optional read replica. Snapshot/list reads route here so the
# primary is left for writes. When unset the app reads from the primary
# (local dev needs nothing). Replica lag of 100-500 ms is fine: the
# snapshot cache and the 45 s presence window both mask it.
# DATABASE_REPLICA_URL=postgresql://.../app_db
# DATABASE_REPLICA_POOL_MAX=50

# Upstash Redis (OPTIONAL — the hot path no longer requires it).
#
# As of the Redis-cost cleanup, the WS + HTTP snapshot path and player
# presence are served entirely from in-process memory and Postgres, so a
# normal run issues ZERO Upstash commands. Redis is only used when you
# explicitly opt into one of the features below:
#   SNAPSHOT_REDIS_CACHE=1  → cross-process snapshot cache
#   ENABLE_REDIS_PUBSUB=1   → world_changes pub/sub bridge
# When UPSTASH_REDIS_REST_URL is unset, the client falls back to an
# in-process memory implementation and nothing is billed.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Phase 2 — sim worker (world-tickd.ts) and WS server (server.ts).
# The Next.js server and the WebSocket server share one port (3000 by
# default); the WS is mounted at /ws on the same HTTP server so the
# browser sends the session cookie on the upgrade.
# PORT=3000
# NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws
# NPC / animal / enemy movement (see "Movement" in AGENTS.md). The world
# beat is fixed at 5 s; each entity takes one exact-tile N/S/E/W step
# every interval, staggered onto its own beat. Values are rounded UP to
# a whole number of beats (e.g. 12000 -> 15000). Restart tickd to apply.
# NPC_MOVE_INTERVAL_MS=10000
# NPC_MOVE_MIN_TILES=1            # each NPC step walks an exact whole
# NPC_MOVE_MAX_TILES=10           # number of tiles in this range
# ANIMAL_MOVE_INTERVAL_MS=10000
# ENEMY_MOVE_INTERVAL_MS=10000
# WS_RESYNC_MS=30000              # full-snapshot safety resync per client;
#                                 # moves themselves go out as tiny per-beat
#                                 # messages, so this can stay long.
# WS_SKIP_BUFFERED_BYTES=65536    # skip a beat message for a socket with
#                                 # this much still buffered (slow client)
# SNAPSHOT_PROC_CACHE_TTL_MS=5000 # in-process snapshot cache TTL (dropped every beat anyway)
# SNAPSHOT_PROC_CACHE_SIZE=256    # max chunks held in the in-process cache
# SNAPSHOT_REDIS_CACHE=0          # 1 = also cache snapshots in Redis (multi-process only)
# SNAPSHOT_TTL_MS=250             # Redis snapshot TTL, used only when the above is 1
# LAST_SEEN_TTL_SECONDS=10        # in-memory throttle between lastSeenAt writes
# CHUNK_REGISTRY_CAPACITY=2000    # LRU cap on the in-memory chunk collision map

# Phase 3 - read path.
# PROXIMITY_RADIUS_PX=1152        # proximity bbox half-size, in pixels
# PRESENCE_WRITE_INTERVAL_MS=10000  # min gap between a player's presence writes (WS)
# ONLINE_PLAYERS_REFRESH_MS=5000  # how often the sim worker refreshes the
#                                 # online_players materialized view
# PRESENCE_WINDOW_MS=45000        # "online" window (also the view's WHERE)

# Phase 4 — hardening.
# WS_MAX_UPGRADES_PER_IP=10 + WS_IP_WINDOW_MS=10000  # reconnect-storm rate limit
# SLOW_CLIENT_THRESHOLD_BYTES=262144 + SLOW_CLIENT_HOLD_MS=2000  # slow-client eviction
# LOG_LEVEL=info
# SERVICE_NAME=ai-village
# WS_SHARD_ID=0
# ENABLE_REDIS_PUBSUB=0           # 1 = start the world_changes subscriber (no publisher today)

# Stripe (optional - without these the app runs in sandbox mode)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# LLM-driven NPC dialogue (optional - without these the scripted brain runs).
# Any one of OPENAI / DEEPSEEK / MINIMAX is enough; set LLM_PROVIDER to force.
# LLM_FALLBACK="deepseek,openai" adds a failover chain on error.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# MINIMAX_API_KEY=
# MINIMAX_MODEL=
# LLM_PROVIDER=
# LLM_FALLBACK=
# Per-character cap on LLM-powered NPC replies per minute (falls back to
# scripted). Defaults to 3.
# NPC_LLM_RATE_PER_MIN=

# Admin / debug endpoints (send NPCs on trips, plan routes, …): requests need
# `x-admin-token: <ADMIN_TOKEN>`. Unset or under 24 characters = endpoints off.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# NPC minds (src/lib/mind/): Jev (TypeSafe System One) picks what NPCs with
# a mind do next. Without a key a scripted policy decides instead.
TYPESAFE_API_KEY=
# Which NPCs have a mind, and how often each one thinks (ms).
MIND_NPCS=village_marigold
MIND_INTERVAL_MS=60000
