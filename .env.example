# Copy to .env and fill in. Never commit .env - it's gitignored.

# PostgreSQL - matches drizzle.config.json. For Docker: see README.
#   docker run --name pg-pixel-village -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=app_db -p 5432:5432 -d postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Stripe (optional - without these the app runs in sandbox mode)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# LLM-driven NPC dialogue (optional - without these the scripted brain runs).
# Any one of OPENAI / DEEPSEEK / MINIMAX is enough; set LLM_PROVIDER to force.
# LLM_FALLBACK="deepseek,openai" adds a failover chain on error.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# MINIMAX_API_KEY=
# MINIMAX_MODEL=
# LLM_PROVIDER=
# LLM_FALLBACK=
