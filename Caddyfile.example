# Caddy in front of the single app process (src/server.ts, port 3000).
# Caddy gets a Let's Encrypt certificate for SITE_DOMAIN and proxies
# WebSocket upgrades on /ws automatically, so no extra routing is needed.
#
#   SITE_DOMAIN=game.example.com caddy run --config Caddyfile.example
#   (or put the same site block in /etc/caddy/Caddyfile on the droplet)

{$SITE_DOMAIN} {
  encode zstd gzip
  reverse_proxy localhost:3000
}
