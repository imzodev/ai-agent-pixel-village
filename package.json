{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,tickd -c blue,green \"npm:dev:server\" \"npm:dev:tickd\"",
    "dev:server": "tsx --env-file=.env src/server.ts",
    "dev:tickd": "tsx --env-file=.env src/lib/world-tickd.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx --env-file=.env src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "fetch:lpc": "node scripts/fetch-lpc.mjs"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@upstash/redis": "^1.38.4",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "nipplejs": "^1.0.4",
    "pg": "8.20.0",
    "phaser": "^4.2.1",
    "pino": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
